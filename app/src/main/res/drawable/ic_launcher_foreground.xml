    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing backdrop circle -->
    <path
        android:pathData="M54,28 A26,26 0 1,0 54,80 A26,26 0 1,0 54,28"
        android:fillColor="#1500E5FF" />

    <!-- Upper Transfer Arrow (Rightwards / Sending) -->
